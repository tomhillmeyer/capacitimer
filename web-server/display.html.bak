<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="apple-mobile-web-app-title" content="Capacitimer">
    <meta name="theme-color" content="#000000">
    <title>Capacitimer</title>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" href="/capacitimer.png">
    <link rel="apple-touch-icon" href="/capacitimer.png">
    <link rel="stylesheet" href="/shared-styles.css">
    <script src="/settings.js"></script>
    <style>
        /* Disable iOS double-tap to zoom */
        * {
            touch-action: manipulation;
        }

        /* Connection Lost Overlay */
        .connection-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            gap: 2rem;
        }

        .connection-overlay.active {
            display: flex;
        }

        .connection-overlay h2 {
            color: #ff4444;
            font-size: 4vw;
            margin: 0;
        }

        .connection-overlay p {
            color: #aaa;
            font-size: 2vw;
            margin: 0;
        }

        .spinner {
            width: 80px;
            height: 80px;
            border: 8px solid #333;
            border-top: 8px solid #4488ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>

<body class="fullscreen-display">
    <!-- Connection Lost Overlay -->
    <div class="connection-overlay" id="connectionOverlay">
        <h2>Connection Lost</h2>
        <p>Attempting to reconnect to server...</p>
        <div class="spinner"></div>
    </div>

    <div class="timer-display">
        <div class="timer-value" id="timerValue">0:00</div>
        <div class="timer-status" id="timerStatus">READY</div>
    </div>

    <script>
        let updateInterval;
        let localUpdateInterval;
        let cachedState = null;
        let ws = null;
        let fontSize = 20; // Font size in vw units for timer
        let timeOfDayFontSize = 4; // Font size in vw units for time of day
        let reconnectAttempts = 0;
        let reconnectTimeout = null;
        let connectionTimeout = null;

        // Calculate optimal font size for timer display
        function calculateFontSize() {
            const timerValue = document.getElementById('timerValue');
            const container = timerValue.parentElement;
            if (!container) return;

            // Create a temporary element to measure text width
            const temp = document.createElement('div');
            temp.style.position = 'absolute';
            temp.style.visibility = 'hidden';
            temp.style.whiteSpace = 'nowrap';
            temp.style.fontFamily = settingsManager.get('timerFont') || 'monospace';
            temp.style.fontWeight = 'bold';

            // Generate a sample text with worst-case width (all segments at max)
            const settings = settingsManager.getAll();
            let sampleText = '';
            if (settings.showHours) sampleText += '88';
            if (settings.showHours && (settings.showMinutes || settings.showSeconds)) sampleText += ':';
            if (settings.showMinutes) sampleText += '88';
            if (settings.showMinutes && settings.showSeconds) sampleText += ':';
            if (settings.showSeconds) sampleText += '88';
            if (settings.showMilliseconds && settings.showSeconds) sampleText += '.888';
            if (!sampleText) sampleText = '888888'; // Fallback

            temp.textContent = sampleText;
            document.body.appendChild(temp);

            // Binary search for optimal font size (in vw units)
            const containerWidth = container.clientWidth;
            let minSize = 1;
            let maxSize = 25;
            let optimalSize = 20;

            while (maxSize - minSize > 0.1) {
                const midSize = (minSize + maxSize) / 2;
                temp.style.fontSize = `${midSize}vw`;

                const textWidth = temp.offsetWidth;
                const availableWidth = containerWidth * 0.95; // Leave 5% padding

                if (textWidth <= availableWidth) {
                    optimalSize = midSize;
                    minSize = midSize;
                } else {
                    maxSize = midSize;
                }
            }

            document.body.removeChild(temp);
            fontSize = optimalSize;
            timerValue.style.fontSize = `${fontSize}vw`;
        }

        // Calculate optimal font size for time of day display
        function calculateTimeOfDayFontSize() {
            const timerStatus = document.getElementById('timerStatus');
            const container = timerStatus.parentElement;
            if (!container || !settingsManager.get('showTimeOfDay')) return;

            // Create a temporary element to measure text width
            const temp = document.createElement('div');
            temp.style.position = 'absolute';
            temp.style.visibility = 'hidden';
            temp.style.whiteSpace = 'nowrap';
            temp.style.fontFamily = settingsManager.get('timerFont') || 'monospace';
            temp.style.fontWeight = 'bold';
            temp.style.letterSpacing = '0.2em';

            // Sample text for worst-case width: "12:00 PM"
            temp.textContent = '12:00 PM';
            document.body.appendChild(temp);

            // Binary search for optimal font size (in vw units)
            const containerWidth = container.clientWidth;
            let minSize = 1;
            let maxSize = 15;
            let optimalSize = 4;

            while (maxSize - minSize > 0.1) {
                const midSize = (minSize + maxSize) / 2;
                temp.style.fontSize = `${midSize}vw`;

                const textWidth = temp.offsetWidth;
                const availableWidth = containerWidth * 0.95; // Leave 5% padding

                if (textWidth <= availableWidth) {
                    optimalSize = midSize;
                    minSize = midSize;
                } else {
                    maxSize = midSize;
                }
            }

            document.body.removeChild(temp);
            timeOfDayFontSize = optimalSize;
        }

        // WebSocket connection
        function connectWebSocket() {
            // Clear any existing timeouts
            if (reconnectTimeout) {
                clearTimeout(reconnectTimeout);
                reconnectTimeout = null;
            }
            if (connectionTimeout) {
                clearTimeout(connectionTimeout);
                connectionTimeout = null;
            }

            // Close existing connection if any
            if (ws && (ws.readyState === WebSocket.CONNECTING || ws.readyState === WebSocket.OPEN)) {
                ws.close();
            }

            // Show connection overlay
            document.getElementById('connectionOverlay').classList.add('active');

            // Use the current hostname to connect to WebSocket server
            const wsHost = window.location.hostname;
            console.log(`Attempting WebSocket connection to ws://${wsHost}:3001 (attempt ${reconnectAttempts + 1})`);

            try {
                ws = new WebSocket(`ws://${wsHost}:3001`);
            } catch (error) {
                console.error('Failed to create WebSocket:', error);
                scheduleReconnect();
                return;
            }

            // Set a connection timeout in case WebSocket never calls onopen or onclose
            connectionTimeout = setTimeout(() => {
                console.log('WebSocket connection timeout');
                if (ws && ws.readyState === WebSocket.CONNECTING) {
                    ws.close(); // Force close, which will trigger onclose
                }
            }, 5000);

            ws.onopen = () => {
                console.log('WebSocket connected successfully');
                // Clear connection timeout
                if (connectionTimeout) {
                    clearTimeout(connectionTimeout);
                    connectionTimeout = null;
                }
                reconnectAttempts = 0; // Reset on successful connection
                // Hide connection overlay
                document.getElementById('connectionOverlay').classList.remove('active');
                // Fetch current state to sync
                fetchTimerState();
            };

            ws.onmessage = (event) => {
                const message = JSON.parse(event.data);

                if (message.type === 'timer-update') {
                    cachedState = message.data;
                    updateDisplay(message.data);
                } else if (message.type === 'settings-update') {
                    // Update settings from broadcast (without saving back to server)
                    const timeUnitChanged = ['showHours', 'showMinutes', 'showSeconds', 'showMilliseconds'].some(
                        key => message.data.hasOwnProperty(key)
                    );
                    const timerFontChanged = ['timerFont'].some(
                        key => message.data.hasOwnProperty(key)
                    );
                    settingsManager.setAllLocal(message.data);
                    // Recalculate font size if time units or timer font changed
                    if (timeUnitChanged || timerFontChanged) {
                        calculateFontSize();
                        calculateTimeOfDayFontSize();
                    }
                    // Update display with new settings
                    if (cachedState) {
                        updateDisplay(cachedState);
                    }
                }
            };

            ws.onclose = (event) => {
                console.log('WebSocket closed:', event.code, event.reason);
                // Show connection overlay
                document.getElementById('connectionOverlay').classList.add('active');
                scheduleReconnect();
            };

            ws.onerror = (error) => {
                console.error('WebSocket error:', error);
                // Show connection overlay
                document.getElementById('connectionOverlay').classList.add('active');
                // Note: onclose will handle reconnection
            };
        }

        function scheduleReconnect() {
            if (reconnectTimeout) {
                return; // Already scheduled
            }

            reconnectAttempts++;
            // Exponential backoff: 1s, 2s, 4s, 8s, max 10s
            const delay = Math.min(1000 * Math.pow(2, Math.min(reconnectAttempts - 1, 3)), 10000);
            console.log(`Scheduling reconnect in ${delay}ms`);

            reconnectTimeout = setTimeout(() => {
                reconnectTimeout = null;
                connectWebSocket();
            }, delay);
        }

        function formatTime(seconds) {
            return settingsManager.formatTime(seconds);
        }

        function getTimerColor(seconds) {
            return settingsManager.getTimerColor(seconds);
        }

        function calculateTimeRemaining(state) {
            if (!state.isRunning || !state.endTime) {
                // Use pausedTimeRemaining to preserve milliseconds when paused
                return state.pausedTimeRemaining || state.timeRemaining;
            }

            const now = Date.now();
            const remainingMs = state.endTime - now;

            // If count up after zero is enabled and time is past endTime, return negative
            if (settingsManager.get('countUpAfterZero') && remainingMs < 0) {
                return remainingMs / 1000; // Return negative fractional seconds
            }

            // Otherwise clamp to 0
            return Math.max(0, remainingMs) / 1000;
        }

        function formatTimeOfDay() {
            if (!settingsManager.get('showTimeOfDay')) {
                return '';
            }
            const now = new Date();
            let hours = now.getHours();
            const minutes = now.getMinutes();
            const ampm = hours >= 12 ? 'PM' : 'AM';

            hours = hours % 12;
            hours = hours ? hours : 12;

            return `${hours}:${minutes.toString().padStart(2, '0')} ${ampm}`;
        }

        function updateDisplay(state) {
            const timerValue = document.getElementById('timerValue');
            const timerStatus = document.getElementById('timerStatus');
            const timerDisplay = document.querySelector('.timer-display');
            const settings = settingsManager.getAll();

            let timeRemaining = calculateTimeRemaining(state);

            // Check visibility settings
            const showTimer = settings.showTimer !== false;
            const showTimeOfDay = settings.showTimeOfDay !== false;

            // Handle timer visibility
            if (showTimer) {
                timerValue.textContent = formatTime(timeRemaining);
                timerValue.style.display = 'block';

                // Apply timer styling
                timerValue.style.fontFamily = settings.timerFont || 'monospace';
                const baseFontSize = fontSize * (settings.timerFontSize || 100) / 100;
                timerValue.style.fontSize = `${baseFontSize}vw`;

                // Set red background and white text when counting up past zero
                if (timeRemaining < 0) {
                    if (timerDisplay) timerDisplay.style.backgroundColor = '#cc0000';
                    document.body.style.backgroundColor = '#cc0000';
                    timerValue.style.color = '#ffffff';
                } else {
                    if (timerDisplay) timerDisplay.style.backgroundColor = '#000000';
                    document.body.style.backgroundColor = '#000000';
                    timerValue.style.color = getTimerColor(Math.abs(timeRemaining));
                }
            } else {
                timerValue.style.display = 'none';
                if (timerDisplay) timerDisplay.style.backgroundColor = '#000000';
                document.body.style.backgroundColor = '#000000';
            }

            // Show time of day
            const timeOfDay = formatTimeOfDay();
            if (showTimeOfDay && timeOfDay) {
                timerStatus.textContent = timeOfDay;
                timerStatus.style.display = 'block';
                // Apply time of day styling
                timerStatus.style.fontFamily = settings.timerFont || 'monospace';
                const baseTODFontSize = timeOfDayFontSize * (settings.timeOfDayFontSize || 100) / 100;
                timerStatus.style.fontSize = `${baseTODFontSize}vw`;
                timerStatus.style.color = settings.timeOfDayColor || '#ffffff';
            } else {
                timerStatus.style.display = 'none';
            }
        }

        function updateClock() {
            if (cachedState) {
                updateDisplay(cachedState);
            }
        }

        async function fetchTimerState() {
            try {
                const response = await fetch('/api/timer');
                const state = await response.json();
                cachedState = state;
                updateDisplay(state);
            } catch (error) {
                console.error('Failed to fetch timer state:', error);
            }
        }

        function updateLocalDisplay() {
            if (cachedState && cachedState.isRunning) {
                updateDisplay(cachedState);
            }
        }

        // Load settings from server first
        settingsManager.loadSettings().then(() => {
            // Connect to WebSocket for real-time updates
            connectWebSocket();

            // Initial fetch (WebSocket will handle updates after this)
            fetchTimerState();

            // Calculate font sizes on load
            setTimeout(() => {
                calculateFontSize();
                calculateTimeOfDayFontSize();
            }, 100);
        });

        // Update display locally at 10fps for smooth countdown when running
        localUpdateInterval = setInterval(updateLocalDisplay, 100);

        // Update clock every second
        setInterval(updateClock, 1000);
        window.addEventListener('resize', () => {
            calculateFontSize();
            calculateTimeOfDayFontSize();
        });
    </script>
</body>

</html>